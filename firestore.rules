rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Attendance collection security rules
    match /attendance/{documentId} {
      
      // Allow read access for authenticated users (or authorized roles)
      // For testing / initial development before auth integration:
      // allow read, write: if true;
      allow read: if request.auth != null;

      // Allow create only if user is authenticated and payload satisfies integrity checks
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.status in ['Present', 'Late', 'Half-Day', 'Absent']
        && request.resource.data.createdAt != null;

      // Allow updates only on status, check-in, check-out, or notes while preserving createdAt
      allow update: if request.auth != null
        && request.resource.data.status in ['Present', 'Late', 'Half-Day', 'Absent']
        && request.resource.data.createdAt == resource.data.createdAt;

      // Allow deletion only by authenticated administrators
      allow delete: if request.auth != null;
    }
  }
}
